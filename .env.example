# lingo-async — SQS-driven Lambda worker. No HTTP. No user secrets.

# AWS region for DynamoDB clients (Lambda runtime sets AWS_REGION automatically;
# this only matters for local pytest / scripts).
AWS_REGION=us-west-1

# Dynamo table prefix — must match the lingo_ prefix used by lingo-core /
# lingo-infra so we hit the same tables (users, social_leaderboard, quests).
DYNAMODB_TABLE_PREFIX=lingo_

# Logging — set to DEBUG locally, INFO in Lambda (env-driven so a noisy
# investigation doesn't require a deploy).
LOG_LEVEL=INFO

# Event log — set to "sqlite" in local dev so the inspector at
# lingo /admin/events has data. Leave unset in prod until the Dynamo
# impl ships.
EVENT_LOG_BACKEND=sqlite
EVENT_LOG_SQLITE_PATH=/tmp/lingo-events.sqlite

# Service-to-service callback into lingo-core for quest progress.
LINGO_CORE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=dev-shared-secret
